<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
        <RuntimeIdentifiers Condition="'$(TargetFramework)'!='net10.0-android'">win-x64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
        <RootNamespace>Mpv</RootNamespace>
    </PropertyGroup>

    <ItemGroup Condition="('$(RuntimeIdentifier)'=='win-x64' or '$(RuntimeIdentifier)'=='') and '$(TargetFramework)'!='net10.0-android'">
        <Content Include="win-x64\**">
            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)'=='osx-arm64'">
        <Content Include="osx-arm64\**">
            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
    <ItemGroup Condition="'$(RuntimeIdentifier)'=='osx-x64'">
        <Content Include="osx-x64\**">
            <Link>%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
</Project>
