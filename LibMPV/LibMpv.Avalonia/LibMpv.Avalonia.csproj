<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net10.0-android</TargetFrameworks>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Luna.LibMpv.Avalonia</AssemblyName>
        <RootNamespace>Luna.LibMpv.Avalonia</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.0.3"/>
        <PackageReference Include="Avalonia.ReactiveUI" Version="11.3.8"/>
        <PackageReference Include="Avalonia.Android" Version="12.0.3" Condition="'$(TargetFramework)'=='net10.0-android'"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\LibMpv\LibMpv.csproj"/>
    </ItemGroup>
</Project>
