<UserControl
    MinWidth="340"
    MaxWidth="420"
    d:DesignHeight="450"
    d:DesignWidth="380"
    mc:Ignorable="d"
    x:Class="LunaTV.Views.TVShowPages.ManageDoubanTagsView"
    x:DataType="tvvm:ManageDoubanTagsViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tvvm="using:LunaTV.ViewModels.TVShowPages"
    xmlns:mic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12" Margin="4">

        <!-- Title -->
        <TextBlock
            Classes="H3"
            HorizontalAlignment="Center"
            Text="管理标签" />

        <!-- Add tag -->
        <DockPanel LastChildFill="False">
            <TextBox
                Width="200"
                PlaceholderText="新标签名称"
                Text="{Binding NewTagInput}"
                KeyDown="NewTagInput_KeyDown" />
            <Button
                Margin="8,0,0,0"
                Command="{Binding AddTagCommand}"
                Theme="{DynamicResource ThicknessIconButton}">
                <mic:MaterialIcon Kind="Add" FontSize="16" />
            </Button>
            <Button
                DockPanel.Dock="Right"
                Command="{Binding ResetToDefaultListCommand}"
                Theme="{DynamicResource ThicknessIconButton}"
                ToolTip.Tip="恢复默认标签">
                <mic:MaterialIcon Kind="Restore" FontSize="16" />
            </Button>
        </DockPanel>

        <TextBlock
            Foreground="{DynamicResource SemiRed5}"
            FontSize="12"
            IsVisible="{Binding !!DuplicateWarning}"
            Text="{Binding DuplicateWarning}" />

        <!-- Tag list -->
        <Border
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="1"
            CornerRadius="8"
            MinHeight="180"
            MaxHeight="300"
            Padding="4">
            <ListBox
                Name="TagList"
                Background="Transparent"
                ItemsSource="{Binding Tags}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="6,4"
                            CornerRadius="4"
                            Cursor="Hand"
                            PointerPressed="TagItem_PointerPressed"
                            PointerMoved="TagItem_PointerMoved"
                            PointerReleased="TagItem_PointerReleased"
                            PointerCaptureLost="TagItem_PointerCaptureLost">
                            <DockPanel>
                                <mic:MaterialIcon
                                    Kind="Menu"
                                    FontSize="14"
                                    Foreground="{DynamicResource SemiColorText3}"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="{Binding}"
                                    VerticalAlignment="Center" />
                                <Button
                                    DockPanel.Dock="Right"
                                    Padding="4"
                                    Margin="8,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding $parent[UserControl].((tvvm:ManageDoubanTagsViewModel)DataContext).RemoveTagByParamCommand}"
                                    CommandParameter="{Binding}">
                                    <mic:MaterialIcon Kind="Close" FontSize="13" Foreground="{DynamicResource SemiColorText3}" />
                                </Button>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock
            Classes="Small Secondary"
            HorizontalAlignment="Center"
            Text="{Binding TagCountText}" />
        <TextBlock
            Classes="Small Secondary"
            HorizontalAlignment="Center"
            Text="拖拽排序，点 x 删除" />

    </StackPanel>
</UserControl>
