<UserControl
    d:DesignHeight="800"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="LunaTV.Views.TVShowPages.TVShowSettingView"
    x:DataType="tvvm:TVShowSettingViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tvvm="using:LunaTV.ViewModels.TVShowPages"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Panel Margin="12,20,12,0">
        <TextBlock
            FontSize="32"
            FontWeight="ExtraBold"
            HorizontalAlignment="Left"
            IsHitTestVisible="False"
            Text="设置"
            VerticalAlignment="Top">
            <TextBlock.Foreground>
                <LinearGradientBrush EndPoint="100%,100%" StartPoint="0%,0%">
                    <GradientStop Color="#FF6094EA" Offset="0" />
                    <GradientStop Color="#FFF02FC2" Offset="1" />
                </LinearGradientBrush>
            </TextBlock.Foreground>
            <TextBlock.Effect>
                <DropShadowEffect Color="Black" Opacity="0.1" />
            </TextBlock.Effect>
        </TextBlock>

        <TabbedPage TabPlacement="Top">
            <ContentPage Header="播放" Icon="{DynamicResource SemiIconSetting}">
                <Grid Margin="0,8" RowDefinitions="Auto,*">
                    <StackPanel
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        Margin="8,0"
                        Orientation="Horizontal">
                        <u:IconButton
                            Background="{DynamicResource SemiPink3}"
                            Command="{Binding ExportSettingsCommand}"
                            Content="导出配置"
                            CornerRadius="10"
                            DockPanel.Dock="Right"
                            Foreground="{DynamicResource SemiColorText1}"
                            HorizontalAlignment="Right"
                            Icon="{StaticResource SemiIconExport}"
                            IconPlacement="Left" />

                        <u:IconButton
                            Background="{DynamicResource SemiPink3}"
                            Command="{Binding ImportSettingsCommand}"
                            Content="导入配置"
                            CornerRadius="10"
                            DockPanel.Dock="Right"
                            Foreground="{DynamicResource SemiColorText1}"
                            HorizontalAlignment="Right"
                            Icon="{StaticResource SemiIconImport}"
                            IconPlacement="Left" />
                    </StackPanel>

                    <Grid ColumnDefinitions="3*,2*,2*" Grid.Row="1">
                        <Border
                            Classes="Hover"
                            Grid.Row="0"
                            Theme="{StaticResource CardBorder}">
                            <HeaderedContentControl HorizontalAlignment="Stretch" Theme="{DynamicResource GroupBox}">
                                <HeaderedContentControl.Header>
                                    <SelectableTextBlock Text="数据源设置" />
                                </HeaderedContentControl.Header>
                                <HeaderedContentControl.Content>
                                    <Grid RowDefinitions="Auto,*,Auto,*,Auto">
                                        <StackPanel
                                            Grid.Row="0"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Classes="Tertiary"
                                                Command="{Binding SelectAllCommand}"
                                                Content="全选" />
                                            <Button
                                                Classes="Tertiary"
                                                Command="{Binding SelectNoneCommand}"
                                                Content="全不选" />
                                            <Button
                                                Classes="Tertiary"
                                                Command="{Binding SelectCommonApiCommand}"
                                                Content="全选普通资源" />
                                        </StackPanel>

                                        <Border
                                            Classes="Shadow"
                                            Grid.Row="1"
                                            Margin="0,8,0,0"
                                            Padding="4"
                                            Theme="{StaticResource CardBorder}">
                                            <Grid RowDefinitions="Auto,Auto,*">
                                                <TextBlock
                                                    Classes="Quaternary"
                                                    FontSize="12"
                                                    Text="普通资源" />
                                                <Border
                                                    Background="{DynamicResource SemiColorFill2}"
                                                    Grid.Row="1"
                                                    Height="1"
                                                    Opacity="0.3" />
                                                <ListBox
                                                    AutoScrollToSelectedItem="True"
                                                    Grid.Row="2"
                                                    ItemsSource="{Binding CommonApis}">
                                                    <ListBox.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="Height" Value="32" />
                                                        </Style>
                                                    </ListBox.Styles>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox
                                                                Command="{Binding $parent[UserControl].((tvvm:TVShowSettingViewModel)DataContext).SelectApiCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsChecked="{Binding Enable}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Text="{Binding Name}"
                                                                        VerticalAlignment="Center" />
                                                                    <PathIcon
                                                                        Classes="Small"
                                                                        Data="{DynamicResource SemiIconLikeHeart}"
                                                                        Foreground="#D52515"
                                                                        IsVisible="{Binding IsCustom}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid
                                                                ColumnSpacing="0"
                                                                Columns="3"
                                                                RowSpacing="0"
                                                                VerticalAlignment="Top" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                </ListBox>
                                            </Grid>
                                        </Border>

                                        <GridSplitter Grid.Row="2" ShowsPreview="True" />

                                        <Border
                                            Classes="Shadow"
                                            Grid.Row="3"
                                            Margin="0"
                                            Padding="4"
                                            Theme="{StaticResource CardBorder}">
                                            <Grid RowDefinitions="Auto,Auto,*">
                                                <TextBlock
                                                    Classes="Quaternary"
                                                    FontSize="12"
                                                    Text="异度空间" />
                                                <Border
                                                    Background="{DynamicResource SemiColorFill2}"
                                                    Grid.Row="1"
                                                    Height="1"
                                                    Opacity="0.3" />
                                                <ListBox
                                                    AutoScrollToSelectedItem="True"
                                                    Grid.Row="2"
                                                    ItemsSource="{Binding AdultApis}">
                                                    <ListBox.Styles>
                                                        <Style Selector="ListBoxItem">
                                                            <Setter Property="Height" Value="32" />
                                                        </Style>
                                                    </ListBox.Styles>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox
                                                                Command="{Binding $parent[UserControl].((tvvm:TVShowSettingViewModel)DataContext).SelectAdultApiCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsChecked="{Binding Enable}">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock
                                                                        FontSize="12"
                                                                        Foreground="#F0B114"
                                                                        Text="{Binding Name}"
                                                                        VerticalAlignment="Center" />
                                                                    <PathIcon
                                                                        Classes="Small"
                                                                        Data="{DynamicResource SemiIconLikeHeart}"
                                                                        Foreground="#F0B114"
                                                                        IsVisible="{Binding IsCustom}" />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid
                                                                ColumnSpacing="0"
                                                                Columns="3"
                                                                RowSpacing="0"
                                                                VerticalAlignment="Top" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                </ListBox>
                                            </Grid>
                                        </Border>
                                        <StackPanel
                                            Grid.Row="4"
                                            Margin="0,4,0,0"
                                            Orientation="Horizontal">
                                            <TextBlock Text="已选API数量：" />
                                            <TextBlock Text="{Binding SelectedApiCount}" />
                                        </StackPanel>
                                    </Grid>
                                </HeaderedContentControl.Content>
                            </HeaderedContentControl>
                        </Border>

                        <Grid Grid.Column="1" RowDefinitions="*,Auto">
                            <Border
                                Classes="Hover"
                                Grid.Column="1"
                                Theme="{StaticResource CardBorder}">
                                <HeaderedContentControl HorizontalAlignment="Stretch" Theme="{DynamicResource GroupBox}">
                                    <HeaderedContentControl.Header>
                                        <DockPanel HorizontalSpacing="4">
                                            <SelectableTextBlock
                                                DockPanel.Dock="Left"
                                                HorizontalAlignment="Left"
                                                Text="自定义API"
                                                VerticalAlignment="Center" />
                                            <Button
                                                Command="{Binding AddCustomApiCommand}"
                                                Content="+"
                                                DockPanel.Dock="Left"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />
                                            <u:PopConfirm
                                                ConfirmCommand="{Binding PinCodeConfirmCommand}"
                                                DockPanel.Dock="Right"
                                                PopupHeader="身形还是鹤形？">
                                                <u:IconButton
                                                    Classes="Colorful Primary"
                                                    Content="云宫迅音"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    Icon="{StaticResource SemiIconFaceuLogo}" />
                                                <u:PopConfirm.PopupContent>
                                                    <StackPanel Spacing="8">
                                                        <u:PinCode
                                                            CompleteCommand="{Binding PinCodeCompleteCommand}"
                                                            Count="4"
                                                            Mode="Digit"
                                                            PasswordChar="*"
                                                            u:FormItem.Label="天之语" />
                                                        <TextBlock
                                                            Classes="Success"
                                                            HorizontalAlignment="Center"
                                                            Text="{Binding PinCodeIndicator}" />
                                                    </StackPanel>
                                                </u:PopConfirm.PopupContent>
                                            </u:PopConfirm>
                                        </DockPanel>
                                    </HeaderedContentControl.Header>
                                    <HeaderedContentControl.Content>
                                        <ListBox AutoScrollToSelectedItem="True" ItemsSource="{Binding ApiCustoms}">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Height" Value="32" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel HorizontalSpacing="4">
                                                        <TextBlock
                                                            DockPanel.Dock="Left"
                                                            FontSize="12"
                                                            Text="{Binding Name}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{DynamicResource SemiLime6Color}"
                                                            Text="{Binding Source}"
                                                            VerticalAlignment="Center" />
                                                        <PathIcon
                                                            Data="{DynamicResource SemiIconBell}"
                                                            FontSize="10"
                                                            Foreground="#F0B114" />

                                                        <Button
                                                            Command="{Binding $parent[UserControl].((tvvm:TVShowSettingViewModel)DataContext).DeleteCustomApiCommand}"
                                                            CommandParameter="{Binding}"
                                                            DockPanel.Dock="Right"
                                                            Height="28"
                                                            HorizontalAlignment="Right"
                                                            Theme="{DynamicResource BorderlessButton}">
                                                            <PathIcon Data="{DynamicResource SemiIconDelete}" FontSize="10" />
                                                        </Button>
                                                    </DockPanel>


                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </HeaderedContentControl.Content>
                                </HeaderedContentControl>
                            </Border>
                            <Border
                                Classes="Hover"
                                Grid.Row="1"
                                Theme="{StaticResource CardBorder}">
                                <HeaderedContentControl HorizontalAlignment="Stretch" Theme="{DynamicResource GroupBox}">
                                    <HeaderedContentControl.Header>
                                        <SelectableTextBlock Text="功能开关" />
                                    </HeaderedContentControl.Header>
                                    <HeaderedContentControl.Content>
                                        <StackPanel Spacing="8">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Classes="Tertiary" Text="豆瓣API启用" />
                                                    <TextBlock
                                                        Classes="Quaternary"
                                                        FontSize="12"
                                                        Text="通过豆瓣API获取影视信息" />
                                                </StackPanel>

                                                <ToggleSwitch
                                                    Classes="Large"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    IsChecked="{Binding DoubanApiEnabled}"
                                                    OffContent="关"
                                                    OnContent="开"
                                                    Theme="{StaticResource SimpleToggleSwitch}" />
                                            </DockPanel>
                                            <Border
                                                Background="{DynamicResource SemiColorFill2}"
                                                Height="1"
                                                Opacity="0.3" />
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Classes="Tertiary" Text="豆瓣热门推荐" />
                                                    <TextBlock
                                                        Classes="Quaternary"
                                                        FontSize="12"
                                                        Text="首页显示豆瓣热门影视内容" />
                                                </StackPanel>

                                                <ToggleSwitch
                                                    Classes="Large"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    IsChecked="{Binding HomeAutoLoadDoubanEnabled}"
                                                    OffContent="关"
                                                    OnContent="开"
                                                    Theme="{StaticResource SimpleToggleSwitch}" />
                                            </DockPanel>
                                            <Border
                                                Background="{DynamicResource SemiColorFill2}"
                                                Height="1"
                                                Opacity="0.3" />

                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Classes="Tertiary" Text="强制使用baseurl接口id查询" />
                                                    <TextBlock
                                                        Classes="Quaternary"
                                                        FontSize="12"
                                                        Text="不在使用detail接口查询，detail会访问网页然后模式匹配"
                                                        TextWrapping="Wrap"
                                                        Width="200" />
                                                </StackPanel>

                                                <ToggleSwitch
                                                    Classes="Large"
                                                    DockPanel.Dock="Right"
                                                    HorizontalAlignment="Right"
                                                    IsChecked="{Binding ForceBaseApiNeedChecked}"
                                                    OffContent="关"
                                                    OnContent="开"
                                                    Theme="{StaticResource SimpleToggleSwitch}" />
                                            </DockPanel>

                                        </StackPanel>
                                    </HeaderedContentControl.Content>
                                </HeaderedContentControl>
                            </Border>
                        </Grid>


                        <Border
                            Classes="Hover"
                            Grid.Column="2"
                            Theme="{StaticResource CardBorder}">
                            <HeaderedContentControl HorizontalAlignment="Stretch" Theme="{DynamicResource GroupBox}">
                                <HeaderedContentControl.Header>
                                    <Panel>
                                        <SelectableTextBlock
                                            HorizontalAlignment="Left"
                                            Text="网络测试"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Command="{Binding NetworkTestCommand}"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                            <PathIcon Data="{DynamicResource SemiIconGlobeStroke}" Theme="{DynamicResource InnerPathIcon}" />
                                        </Button>
                                    </Panel>
                                </HeaderedContentControl.Header>
                                <HeaderedContentControl.Content>
                                    <ListBox AutoScrollToSelectedItem="True" ItemsSource="{Binding ApiNets}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel HorizontalSpacing="8">
                                                    <TextBlock
                                                        MinWidth="30"
                                                        Text="{Binding IndexId}"
                                                        VerticalAlignment="Center" />
                                                    <HyperlinkButton Content="{Binding Name}" NavigateUri="{Binding Url}" />
                                                    <PathIcon
                                                        Data="{DynamicResource SemiIconLink}"
                                                        DockPanel.Dock="Right"
                                                        Theme="{DynamicResource InnerPathIcon}" />
                                                    <TextBlock
                                                        DockPanel.Dock="Right"
                                                        HorizontalAlignment="Right"
                                                        Text="{Binding Latency}" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </HeaderedContentControl.Content>
                            </HeaderedContentControl>
                        </Border>
                    </Grid>
                </Grid>
            </ContentPage>

            <ContentPage Header="系统" Icon="{DynamicResource SemiIconHome}">
                <ContentControl Content="{Binding SystemSettings}" />
            </ContentPage>
        </TabbedPage>

    </Panel>
</UserControl>